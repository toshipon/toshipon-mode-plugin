{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "availability",
              "performance",
              "recovery",
              "security",
              "operations",
              "cost"
            ]
          },
          "target": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "enum": [
              "availability_percent",
              "p95_latency_ms",
              "rto_minutes",
              "rpo_minutes",
              "encryption_percent",
              "detection_minutes",
              "monthly_cost_usd"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "context_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^C[0-9]+$"
            }
          }
        },
        "required": [
          "id",
          "category",
          "target",
          "unit",
          "description",
          "metric",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "budget_monthly_usd": {
      "type": "number",
      "minimum": 0
    },
    "technical_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "verified_by": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "id",
          "url",
          "claim",
          "status",
          "verified_by",
          "checked_at"
        ],
        "additionalProperties": false
      }
    },
    "context_binding": {
      "type": "object",
      "properties": {
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "claims_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "context_sha256",
        "claims_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "project",
    "region",
    "requirements",
    "budget_monthly_usd",
    "technical_evidence"
  ],
  "additionalProperties": false
}
