{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+-[0-9]+$"
    },
    "budget_monthly_usd": {
      "type": "number",
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]+$"
          },
          "kind": {
            "enum": [
              "meeting",
              "confluence",
              "aws",
              "file"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "snapshot_path": {
            "type": "string",
            "pattern": "^sources/S[0-9]+\\.txt$"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "locator",
          "version",
          "retrieved_at",
          "owner",
          "content_sha256",
          "snapshot_path"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "project",
    "region",
    "budget_monthly_usd",
    "sources"
  ],
  "additionalProperties": false
}
