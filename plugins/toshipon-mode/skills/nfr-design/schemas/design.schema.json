{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "category": {
            "enum": [
              "availability",
              "performance",
              "recovery",
              "security",
              "operations",
              "cost"
            ]
          },
          "target": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "enum": [
              "availability_percent",
              "p95_latency_ms",
              "rto_minutes",
              "rpo_minutes",
              "encryption_percent",
              "detection_minutes",
              "monthly_cost_usd"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "category",
          "target",
          "unit",
          "description",
          "metric",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^D[0-9]+$"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "requirement_ids",
          "description",
          "evidence_ids",
          "alternatives"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "verified_by": {
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "id",
          "url",
          "claim",
          "status",
          "verified_by",
          "checked_at"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^V[0-9]+$"
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirement_id",
          "method",
          "acceptance",
          "target",
          "unit"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "aws": {
      "type": "object",
      "properties": {
        "az_count": {
          "type": "integer",
          "minimum": 1
        },
        "rto_minutes": {
          "type": "number",
          "minimum": 0
        },
        "rpo_minutes": {
          "type": "number",
          "minimum": 0
        },
        "monthly_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "cost_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "az_count",
        "rto_minutes",
        "rpo_minutes",
        "monthly_cost_usd",
        "cost_basis"
      ],
      "additionalProperties": false
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "severity",
          "status",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "requirements",
    "decisions",
    "evidence",
    "verifications",
    "aws",
    "open_issues",
    "assumptions"
  ],
  "additionalProperties": false
}
