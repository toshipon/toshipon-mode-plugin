{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-improvement/audit.schema.json",
  "title": "Independent auditor output. It carries findings only: no verdict, no criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "limitations"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "claim", "evidence", "next_experiment"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]+$" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "category": {
            "enum": [
              "premise", "evidence", "causality", "falsification", "unexplored", "overfitting",
              "constraint", "side_effect", "alternative", "evaluation", "approach"
            ]
          },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": {
            "description": "Ledger ids, evaluation ids or file refs the finding rests on.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "counter_evidence": { "type": "string" },
          "alternative_hypothesis": { "type": "string" },
          "next_experiment": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
