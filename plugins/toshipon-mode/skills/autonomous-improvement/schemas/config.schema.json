{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-improvement/config.schema.json",
  "title": "User config at <state home>/config.json. Every key is optional; defaults are in store.DEFAULT_CONFIG.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "collect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "description": "Store a redacted, truncated error text with tool-failure records. Off by default.",
          "type": "boolean"
        }
      }
    },
    "retention_days": { "type": "integer", "minimum": 1 },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff_base_seconds": { "type": "number", "minimum": 0 },
        "backoff_max_seconds": { "type": "number", "minimum": 0 },
        "lease_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_jobs_per_dispatch": { "type": "integer", "minimum": 1 },
        "max_seconds_per_dispatch": { "type": "number", "exclusiveMinimum": 0 },
        "max_cost_per_day": { "type": "number", "minimum": 0 }
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "hour", "minute"],
        "properties": {
          "kind": { "enum": ["evolve", "weekly_report"] },
          "weekday": { "description": "0 = Monday. Omit for every day.", "type": "integer", "minimum": 0, "maximum": 6 },
          "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
          "minute": { "type": "integer", "minimum": 0, "maximum": 59 }
        }
      }
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_occurrences": { "type": "integer", "minimum": 2 },
        "min_distinct_sources": { "type": "integer", "minimum": 1 }
      }
    },
    "llm_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_classifications": {
          "description": "Data classifications that may be sent to an LLM adapter.",
          "type": "array",
          "items": { "enum": ["public", "synthetic", "internal", "confidential"] }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypothesize": { "$ref": "#/$defs/adapter" },
        "candidate": { "$ref": "#/$defs/adapter" },
        "auditor": { "$ref": "#/$defs/adapter" }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_paths": {
          "description": "Glob patterns of repository paths a public candidate may touch. Anything else is blocked.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny_terms_file": {
          "description": "Local file, outside any repository, with one forbidden term per line.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "claude": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_budget_usd"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "max_budget_usd": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 7200 },
        "dry_run_safe": {
          "description": "The adapter is local and free of side effects, so --dry-run may execute it.",
          "type": "boolean"
        }
      },
      "oneOf": [{ "required": ["argv"] }, { "required": ["claude"] }]
    }
  }
}
