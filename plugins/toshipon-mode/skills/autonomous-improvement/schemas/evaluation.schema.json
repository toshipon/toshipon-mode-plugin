{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-improvement/evaluation.schema.json",
  "title": "Evaluator adapter output and the evaluation stored in the ledger",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "output": {
      "description": "What an evaluator adapter prints on stdout.",
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": { "type": "number" },
                  "samples": { "type": "array", "minItems": 1, "items": { "type": "number" } },
                  "rationale": { "type": "string", "minLength": 1 }
                },
                "anyOf": [{ "required": ["value"] }, { "required": ["samples"] }]
              }
            ]
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "unevaluable": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "stored": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^EV-[0-9]{4,}$" },
        "purpose": { "enum": ["baseline", "experiment"] },
        "status": { "enum": ["evaluated", "unevaluable", "skipped"] },
        "unevaluable_reason": { "type": ["string", "null"] },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "n", "stddev", "kind", "role"],
            "properties": {
              "value": { "type": "number" },
              "n": { "type": "integer", "minimum": 1 },
              "stddev": { "type": ["number", "null"] },
              "kind": { "enum": ["deterministic", "llm"] },
              "role": { "enum": ["required", "scored"] },
              "rationale": { "type": ["string", "null"] }
            }
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "passed"],
            "properties": { "metric": { "type": "string" }, "passed": { "type": "boolean" } }
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exit_code", "duration_seconds"],
            "properties": {
              "exit_code": { "type": ["integer", "null"] },
              "duration_seconds": { "type": "number" },
              "stderr_tail": { "type": "string" }
            }
          }
        },
        "started_at": { "type": "string" }
      }
    }
  }
}
