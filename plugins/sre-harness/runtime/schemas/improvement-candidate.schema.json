{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-harness:improvement-candidate",
  "title": "improvement-candidate",
  "description": "A rule or check proposed from lessons, as candidates/<IC-id>/candidate.json. The text is the artifact candidates/<IC-id>/body.md; artifact.content_sha256 is its hash. A declarative check is data the harness interprets; generated code is never run. Status changes are made by the harness and a person, never by a backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "created_at",
    "repo",
    "lesson_ids",
    "basis_id",
    "target",
    "form",
    "title",
    "problem",
    "exceptions",
    "artifact",
    "lint",
    "risk",
    "rollback",
    "conflicts",
    "sources",
    "source_trust",
    "untrusted_included",
    "status",
    "version",
    "evaluation_ref",
    "criteria_hash",
    "approval",
    "history",
    "generated_by"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:sre-harness:common#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^IC-[0-9]{4,}$" },
    "run_id": { "$ref": "urn:sre-harness:common#/$defs/run_id" },
    "created_at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "lesson_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^LS-[0-9]{4,}$" }
    },
    "basis_id": {
      "description": "The classified row (CL-) or, with --include-untrusted, the set-aside row (SA-) the candidate was built from.",
      "type": "string",
      "pattern": "^(?:CL|SA)-[0-9]{4,}$"
    },
    "target": { "$ref": "urn:sre-harness:review-classified#/$defs/target" },
    "form": { "enum": ["declarative_check", "prose"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "problem": { "type": "string", "minLength": 1 },
    "exceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "check": {
      "description": "Present when form is declarative_check. Parsed from the artifact.",
      "$ref": "#/$defs/check"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "content_sha256", "file"],
      "properties": {
        "media_type": { "const": "text/markdown" },
        "content_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
        "file": { "const": "body.md" }
      }
    },
    "lint": { "$ref": "#/$defs/lint" },
    "risk": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["existing_ref", "kind", "basis", "quote"],
        "properties": {
          "existing_ref": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["contradicts", "duplicates", "narrows"] },
          "basis": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "source_trust": { "enum": ["member_supported", "external_only", "bot_only"] },
    "untrusted_included": { "type": "boolean" },
    "status": { "enum": ["proposed", "evaluated", "approved", "rejected", "retired"] },
    "version": { "type": "integer", "minimum": 1 },
    "evaluation_ref": { "type": ["string", "null"], "minLength": 1 },
    "criteria_hash": {
      "oneOf": [{ "$ref": "urn:sre-harness:common#/$defs/sha256" }, { "type": "null" }]
    },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "reason",
            "approved_at",
            "candidate_sha256",
            "registry_id",
            "registry_version"
          ],
          "properties": {
            "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "approved_at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
            "candidate_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
            "registry_id": { "type": "string", "pattern": "^RG-[0-9]{4,}$" },
            "registry_version": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "from", "to", "by", "version", "content_sha256"],
        "properties": {
          "at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
          "from": {
            "oneOf": [
              { "enum": ["proposed", "evaluated", "approved", "rejected", "retired"] },
              { "type": "null" }
            ]
          },
          "to": { "enum": ["proposed", "evaluated", "approved", "rejected", "retired"] },
          "by": { "enum": ["generate", "evaluate", "approve", "reject", "retire"] },
          "version": { "type": "integer", "minimum": 1 },
          "content_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
          "note": { "type": "string" }
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "call_id"],
      "properties": {
        "backend": { "enum": ["claude", "stub"] },
        "call_id": { "type": "string", "pattern": "^LC-[0-9]{4,}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "form": { "const": "declarative_check" } } },
      "then": { "required": ["check"] },
      "else": { "not": { "required": ["check"] } }
    },
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": { "approval": { "type": "object" }, "evaluation_ref": { "type": "string" } }
      }
    }
  ],
  "$defs": {
    "lint": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "span"],
        "properties": {
          "kind": { "enum": ["imperative_to_agent", "url", "shell_command", "secret_like"] },
          "span": {
            "description": "[start, end) character offsets into body.md.",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "source": {
      "description": "A comment the candidate rests on, shown to the approver with who wrote it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "comment_id", "author_type", "text", "text_kind"],
      "properties": {
        "thread_id": { "type": "string", "pattern": "^RT-[0-9]{4,}$" },
        "comment_id": { "type": "string", "minLength": 1 },
        "author_login": { "type": "string" },
        "author_type": { "enum": ["user", "bot", "ghost", "unknown"] },
        "author_association": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "text_kind": { "enum": ["quote", "excerpt"] }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_globs", "added_line_pattern", "message"],
      "properties": {
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/*?-]{1,200}$" }
        },
        "added_line_pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "absent_pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
