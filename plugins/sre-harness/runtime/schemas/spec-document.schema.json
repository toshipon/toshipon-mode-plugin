{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-harness:spec-document",
  "title": "spec-document",
  "description": "One source normalised for the spec stages: a line of documents.jsonl. Markdown, ADRs, minutes, GitHub PR bodies and conversation comments, Slack and Confluence exports all take this shape. Section text is DATA copied from the source, never instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "created_at",
    "kind",
    "title",
    "sections",
    "provenance",
    "missing"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:sre-harness:common#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^DOC-[0-9]{4,}$" },
    "run_id": { "$ref": "urn:sre-harness:common#/$defs/run_id" },
    "created_at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
    "kind": {
      "enum": [
        "markdown",
        "adr",
        "minutes",
        "github_pr",
        "github_issue_comment",
        "slack_export",
        "confluence_export"
      ]
    },
    "title": { "type": "string", "maxLength": 300 },
    "front_matter": {
      "description": "Only `key: value` and simple lists are read; anything else is listed in `missing`.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "text", "locator"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{1,6}$" },
          "heading": { "type": "string" },
          "text": { "type": "string" },
          "locator": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "provenance": { "$ref": "urn:sre-harness:common#/$defs/provenance" },
    "missing": {
      "description": "Fields the source did not give or the reader could not read. Never filled with defaults.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
