{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-harness:llm-review-candidates",
  "title": "llm-review-candidates",
  "description": "What `review generate` asks a backend for, one lesson at a time. Self-contained because the Claude CLI receives it as --json-schema. Status, trust, lint and hashes are not here: the harness computes them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate"],
  "properties": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "title", "body", "risk", "rollback"],
      "properties": {
        "form": { "enum": ["declarative_check", "prose"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_globs", "added_line_pattern", "message"],
          "properties": {
            "path_globs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9._/*?-]{1,200}$" }
            },
            "added_line_pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
            "absent_pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "risk": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rollback": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  }
}
