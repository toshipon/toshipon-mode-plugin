{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-harness:llm-spec-extract",
  "title": "llm-spec-extract",
  "description": "What `spec extract` asks a backend for: decisions and requirements the documents imply but do not state in the fixed forms, and ambiguity the rules missed. Self-contained for the Claude CLI. Status `approved` is in the enum only so the harness can refuse it with a reason.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "requirements", "ambiguity"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "content",
          "rationale",
          "status",
          "supersedes",
          "scope",
          "evidence"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^D[0-9]{1,4}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "rationale": { "type": "string", "maxLength": 4000 },
          "status": { "enum": ["proposed", "approved", "rejected", "unresolved"] },
          "supersedes": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["systems", "components", "environments"],
            "properties": {
              "systems": { "$ref": "#/$defs/names" },
              "components": { "$ref": "#/$defs/names" },
              "environments": { "$ref": "#/$defs/names" }
            }
          },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "statement",
          "rationale",
          "nfr_category",
          "decision_refs",
          "acceptance_criteria",
          "evidence"
        ],
        "properties": {
          "key": { "type": "string", "pattern": "^R[0-9]{1,4}$" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "rationale": { "type": "string", "maxLength": 4000 },
          "nfr_category": {
            "enum": [
              "availability",
              "performance",
              "security",
              "operability",
              "cost",
              "compliance",
              null
            ]
          },
          "decision_refs": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "acceptance_criteria": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["given", "when", "then"],
              "properties": {
                "given": { "type": "string", "maxLength": 1000 },
                "when": { "type": "string", "maxLength": 1000 },
                "then": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            }
          },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "ambiguity": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "kind", "span"],
        "properties": {
          "requirement": { "type": "string", "pattern": "^(REQ-[0-9]{4,}|R[0-9]{1,4})$" },
          "kind": { "enum": ["vague_term", "no_metric", "no_criteria", "unbounded", "compound"] },
          "span": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "quote"],
        "properties": {
          "ref": { "type": "string", "pattern": "^DOC-[0-9]{4,}#S[0-9]{1,6}$" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  }
}
