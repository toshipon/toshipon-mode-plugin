{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sre-harness:review-registry",
  "title": "review-registry",
  "description": "One version of a registry entry, as registry/<RG-id>/v<NNNN>.json under the state root. A new version is written for every decision; earlier versions are never changed. An approved version names the evaluation whose candidate hash equals its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "created_at",
    "status",
    "repo",
    "lineage",
    "candidate",
    "evaluation",
    "decision",
    "previous_version",
    "activation"
  ],
  "properties": {
    "schema_version": { "$ref": "urn:sre-harness:common#/$defs/schema_version" },
    "id": { "type": "string", "pattern": "^RG-[0-9]{4,}$" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
    "status": { "enum": ["approved", "rejected", "retired"] },
    "repo": { "type": "string", "minLength": 3 },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "candidate_id"],
      "properties": {
        "run_id": { "$ref": "urn:sre-harness:common#/$defs/run_id" },
        "candidate_id": { "type": "string", "pattern": "^IC-[0-9]{4,}$" }
      }
    },
    "generation": {
      "description": "The generation side of the split the rule was learned from. evaluate leaves the rule out of a baseline whose evaluation PRs overlap these, and leaves out an entry without this record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["prs", "t1"],
      "properties": {
        "prs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "t1": { "$ref": "urn:sre-harness:common#/$defs/timestamp" }
      }
    },
    "candidate": {
      "type": "object",
      "description": "What the artifact (artifact_file, hash content_sha256) says: form, title and check are parsed from it, never taken from candidate.json.",
      "additionalProperties": false,
      "required": ["content_sha256", "form", "title", "artifact_file"],
      "properties": {
        "content_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
        "form": { "enum": ["declarative_check", "prose"] },
        "title": { "type": "string", "minLength": 1 },
        "check": { "$ref": "urn:sre-harness:improvement-candidate#/$defs/check" },
        "artifact_file": { "type": "string", "pattern": "^v[0-9]{4,}\\.md$" }
      }
    },
    "evaluation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256", "criteria_hash", "status", "content_sha256"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
            "criteria_hash": { "$ref": "urn:sre-harness:common#/$defs/sha256" },
            "status": { "enum": ["evaluated", "unevaluable"] },
            "content_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reason", "decided_at", "via"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "decided_at": { "$ref": "urn:sre-harness:common#/$defs/timestamp" },
        "via": {
          "description": "approve needs a terminal and the typed hash prefix; it is not proof of identity.",
          "enum": ["terminal_hash_prefix", "command"]
        }
      }
    },
    "previous_version": { "type": ["integer", "null"], "minimum": 1 },
    "activation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["diff_file", "target_path", "diff_sha256"],
          "properties": {
            "diff_file": { "type": "string", "pattern": "^v[0-9]{4,}\\.diff$" },
            "target_path": { "type": "string", "minLength": 1 },
            "diff_sha256": { "$ref": "urn:sre-harness:common#/$defs/sha256" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "properties": {
          "evaluation": { "type": "object" },
          "decision": { "properties": { "via": { "const": "terminal_hash_prefix" } } }
        }
      }
    }
  ]
}
